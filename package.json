{
  "name": "vinaya",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "harness",
    "processes/*"
  ],
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome lint .",
    "format": "biome format .",
    "format-and-lint": "biome check .",
    "test": "turbo test",
    "verify-docs": "bun packages/aeg-core/bin/verify-docs.ts",
    "clean": "turbo clean",
    "dev:vinaya-studio": "bun apps/cli/src/index.ts studio --port 3208",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "upgrade": "bun apps/cli/src/index.ts upgrade",
    "release": "bun apps/cli/src/index.ts release"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^3.0.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@atta/agents": "file:apps/cli/tests/fixtures/atta-engine/atta-agents-0.1.0.tgz",
    "@atta/engine": "file:apps/cli/tests/fixtures/atta-engine/atta-engine-0.0.1.tgz",
    "@atta/models": "file:apps/cli/tests/fixtures/atta-engine/atta-models-0.1.0.tgz"
  }
}
