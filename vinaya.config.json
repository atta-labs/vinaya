{
  "rings": {
    "ring1_forgeWriteInterception": true,
    "ring2_asyncAudits": true
  },
  "runner": "atta-engine",
  "prePush": {
    "alwaysRun": [
      "apps/cli/tests/ci-shards.test.ts",
      "apps/cli/tests/checks/check-exec-bits.test.ts",
      "apps/cli/tests/checks/changeset-coverage*.test.ts",
      "apps/cli/tests/checks/own-workflow.test.ts",
      "apps/cli/tests/import-boundary.test.ts",
      "apps/cli/tests/surface-spec-exports.test.ts",
      "harness/processes/vinaya-strict/integration/run-paths-only.test.ts",
      "harness/processes/vinaya-strict/integration/log/client/log-callers.test.ts",
      "harness/processes/vinaya-strict/tests/commands/task-status.test.ts"
    ],
    "requiredCi": { "workflow": ".github/workflows/ci.yml", "check": "Vinaya CI" }
  },
  "checks": {
    "atta-labs/secret-scan": {
      "run": "./scripts/vinaya-checks/secret-scan.ts",
      "scope": "full"
    },
    "atta-labs/ui-rules": {
      "run": "./scripts/vinaya-checks/ui-rules.ts",
      "scope": "diff",
      "include": ["apps/vinaya-*/**"],
      "env": { "BASE_SHA": { "optional": true } }
    },
    "atta-labs/process-version-bump": {
      "run": "./scripts/vinaya-checks/process-version-bump.ts",
      "scope": "diff",
      "include": ["harness/processes/vinaya-strict/**"],
      "env": { "BASE_SHA": { "optional": true } }
    }
  },
  "ci": {
    "setup": "set -euo pipefail\nGITLEAKS_VERSION=8.30.1\nGITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb\ncurl -fsSL -o /tmp/gitleaks.tar.gz \"https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz\"\necho \"${GITLEAKS_SHA256}  /tmp/gitleaks.tar.gz\" | sha256sum -c -\nsudo tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks\nsudo chmod +x /usr/local/bin/gitleaks\ngitleaks version"
  },
  "logs": {
    "url": "https://vinaya-log-server.estevez-dani.workers.dev/v1/repos/atta-labs/vinaya/events",
    "headers": {
      "authorization": "Bearer ${VINAYA_LOG_TOKEN}"
    },
    "readHeaders": {
      "authorization": "Bearer ${VINAYA_LOG_READ_TOKEN}"
    }
  },
  "principals": ["daniboomerang"],
  "releaseActor": "daniboomerang",
  "reviewPolicy": {
    "codeReviewThreshold": "MAJOR",
    "securityThreshold": "HIGH",
    "maxTaskMinutes": 600
  },
  "securityScan": {
    "command": ["npx", "--yes", "ecc-agentshield@1.6.0", "scan"]
  },
  "gateCutovers": {
    "objectivesSinceIssue": 404,
    "briefSectionsSinceIssue": 426,
    "documentationSinceIssue": 626,
    "briefRulesSincePr": 394,
    "agentBoxesRefusedSincePr": 396
  },
  "dispatch": {
    "agent": "claude"
  },
  "proseGates": {
    "productPaths": [
      "apps/cli/src",
      ".github/workflows",
      ".vinaya",
      "apps/cli/README.md",
      "packages/sources/README.md",
      "harness/kernel/adapters/agents/agent-line.ts",
      "harness/kernel/adapters/agents/claude-code/loop-narration-claude.ts",
      "harness/kernel/effects/effects.ts",
      "harness/kernel/effects/envelope.ts",
      "harness/kernel/isolation/worker-boundary.ts",
      "harness/kernel/log/client/cli-operation-log.ts",
      "harness/kernel/log/client/log-cache-sqlite.ts",
      "harness/kernel/log/client/log-custom.ts",
      "harness/kernel/log/client/log-schema-digest.ts",
      "harness/kernel/log/client/log-sync-folder-source.ts",
      "harness/kernel/log/client/log-sync-server-source.ts",
      "harness/kernel/log/client/log-sync.ts",
      "harness/kernel/log/client/log-webhook-drain.ts",
      "harness/kernel/log/client/loop-log.ts",
      "harness/kernel/log/log-sink.ts",
      "harness/kernel/run-paths.ts",
      "harness/kernel/source-manifest.ts",
      "harness/kernel/tools/dev-tools-names.ts",
      "harness/kernel/tools/dev-tools-registration.ts",
      "harness/kernel/tools/dev-tools-server.ts",
      "harness/kernel/tools/fetch-documentation.ts",
      "harness/kernel/tools/host/broker.ts",
      "harness/kernel/tools/host/dev-tools-bridge.ts",
      "harness/kernel/tools/host/dev-tools-host.ts",
      "harness/kernel/tools/host/router.ts",
      "harness/kernel/tools/mcp-protocol.ts",
      "harness/kernel/tools/read-source.ts",
      "harness/kernel/tools/role-grants.ts",
      "harness/kernel/tools/source-provider.ts",
      "harness/kernel/tools/tool-catalog.ts",
      "harness/kernel/tools/json-schema-check.ts"
    ],
    "specPaths": [
      "harness/kernel/isolation/isolation.md",
      "harness/kernel/log/log-sync.md",
      "harness/kernel/log/log.md"
    ],
    "sourceComments": {
      "globs": [
        "apps/cli/src",
        "packages/aeg-core/src",
        "packages/aeg-forge-state/src",
        "packages/sources/src",
        "harness/kernel/log/fixtures",
        "harness/kernel/log/sync",
        "harness/kernel/telemetry/questions",
        "harness/kernel/adapters/agents/agent-line.ts",
        "harness/kernel/adapters/agents/claude-code/loop-narration-claude.ts",
        "harness/kernel/effects/effects.ts",
        "harness/kernel/effects/envelope.ts",
        "harness/kernel/isolation/worker-boundary.ts",
        "harness/kernel/issue-documentation.ts",
        "harness/kernel/log/client/cli-operation-log.ts",
        "harness/kernel/log/client/log-cache-sqlite.ts",
        "harness/kernel/log/client/log-custom.ts",
        "harness/kernel/log/client/log-schema-digest.ts",
        "harness/kernel/log/client/log-sync-folder-source.ts",
        "harness/kernel/log/client/log-sync-server-source.ts",
        "harness/kernel/log/client/log-sync.ts",
        "harness/kernel/log/client/log-webhook-drain.ts",
        "harness/kernel/log/client/loop-log.ts",
        "harness/kernel/log/client/narration.test.ts",
        "harness/kernel/log/client/narration.ts",
        "harness/kernel/log/client/schema-digest.test.ts",
        "harness/kernel/log/client/schema-digest.ts",
        "harness/kernel/log/compat.test.ts",
        "harness/kernel/log/custom.test.ts",
        "harness/kernel/log/custom.ts",
        "harness/kernel/log/envelope.test.ts",
        "harness/kernel/log/envelope.ts",
        "harness/kernel/log/log-sink.ts",
        "harness/kernel/log/process-runner.test.ts",
        "harness/kernel/log/redact.test.ts",
        "harness/kernel/log/redact.ts",
        "harness/kernel/log/schema.test.ts",
        "harness/kernel/log/schema.ts",
        "harness/kernel/log/store.test.ts",
        "harness/kernel/log/store.ts",
        "harness/kernel/run-paths.ts",
        "harness/kernel/source-manifest.ts",
        "harness/kernel/tools/dev-tools-names.ts",
        "harness/kernel/tools/dev-tools-registration.ts",
        "harness/kernel/tools/dev-tools-server.ts",
        "harness/kernel/tools/fetch-documentation.ts",
        "harness/kernel/tools/host/broker.ts",
        "harness/kernel/tools/host/dev-tools-bridge.ts",
        "harness/kernel/tools/host/dev-tools-host.ts",
        "harness/kernel/tools/host/router.ts",
        "harness/kernel/tools/host/touched-path.ts",
        "harness/kernel/tools/json-schema-check.ts",
        "harness/kernel/tools/mcp-protocol.ts",
        "harness/kernel/tools/read-source.ts",
        "harness/kernel/tools/role-grants.ts",
        "harness/kernel/tools/source-provider.ts",
        "harness/kernel/tools/tool-catalog.ts"
      ],
      "allowlist": [
        "packages/aeg-forge-state/src/parse-rationale-deps.test.ts",
        "packages/aeg-forge-state/src/amend-rationale-deps.test.ts"
      ],
      "severity": "error"
    },
    "specGrandfather": {
      "apps/cli/specs/dev-review-evaluation-program.md": 46
    },
    "rules": {
      "custom": [
        {
          "id": "decision-id-everywhere",
          "pattern": "\\bD-[0-9]{2,4}\\b",
          "means": "state the decision in plain words instead of citing a decision identifier",
          "scopes": ["spec", "source-comment"],
          "severity": "error"
        }
      ]
    }
  },
  "decisionRecords": {
    "path": "docs/adr"
  },
  "briefSchema": {
    "pr": {
      "sections": [
        {
          "builtin": "tier"
        },
        {
          "builtin": "testPlan"
        },
        {
          "builtin": "testPlanExclusivity"
        },
        {
          "builtin": "closesN"
        },
        {
          "builtin": "project"
        }
      ]
    },
    "issue": {
      "sections": [
        {
          "builtin": "issueRationale"
        },
        {
          "builtin": "objectives"
        },
        {
          "builtin": "briefSections"
        },
        {
          "builtin": "project"
        }
      ]
    }
  },
  "managed": {
    "version": 3,
    "files": [
      ".github/workflows/vinaya-checks.yml",
      ".github/workflows/vinaya-review.yml",
      ".github/workflows/vinaya-review-verdict.yml",
      ".github/workflows/vinaya-archivist.yml",
      ".github/workflows/vinaya-body-checks.yml",
      "vinaya.config.json",
      "AGENTS.md",
      "CLAUDE.md",
      ".vinaya/doc-owners",
      ".claude/settings.json",
      "vinaya/checks/.gitkeep",
      "vinaya/roles/.gitkeep",
      ".gemini/settings.json"
    ],
    "blocks": [
      {
        "path": ".vinaya/hooks/pre-commit",
        "marker": "pre-commit",
        "comment": "hash"
      },
      {
        "path": ".vinaya/hooks/pre-push",
        "marker": "pre-push",
        "comment": "hash"
      },
      {
        "path": ".claude/hooks/track-transcript.sh",
        "marker": "track-transcript",
        "comment": "hash"
      },
      {
        "path": ".vinaya/hooks/commit-msg",
        "marker": "commit-msg",
        "comment": "hash"
      }
    ],
    "labels": [
      "vinaya/tier:0",
      "vinaya/tier:1",
      "vinaya/tier:3",
      "vinaya/needs:execution-input",
      "vinaya/needs:strategy-input",
      "vinaya/needs:principal-input",
      "project:vinaya"
    ]
  }
}
