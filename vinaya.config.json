{
  "rings": {
    "ring1_forgeWriteInterception": false,
    "ring2_asyncAudits": false
  },
  "checks": {
    "atta-labs/secret-scan": {
      "run": "./scripts/vinaya-checks/secret-scan.ts",
      "scope": "full"
    }
  },
  "ci": {
    "setup": "set -euo pipefail\nGITLEAKS_VERSION=8.30.1\nGITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb\ncurl -fsSL -o /tmp/gitleaks.tar.gz \"https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz\"\necho \"${GITLEAKS_SHA256}  /tmp/gitleaks.tar.gz\" | sha256sum -c -\nsudo tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks\nsudo chmod +x /usr/local/bin/gitleaks\ngitleaks version"
  },
  "releaseActor": "daniboomerang",
  "briefSchema": {
    "pr": {
      "sections": [
        {
          "builtin": "tier"
        },
        {
          "builtin": "testPlan"
        },
        {
          "builtin": "testPlanExclusivity"
        },
        {
          "builtin": "closesN"
        },
        {
          "builtin": "project"
        }
      ]
    },
    "issue": {
      "sections": [
        {
          "builtin": "issueRationale"
        },
        {
          "builtin": "project"
        }
      ]
    }
  },
  "managed": {
    "version": 2,
    "files": [
      ".github/workflows/vinaya-checks.yml",
      ".github/workflows/vinaya-review.yml",
      ".github/workflows/vinaya-review-verdict.yml",
      ".github/workflows/vinaya-archivist.yml",
      ".github/workflows/vinaya-body-checks.yml",
      "vinaya.config.json",
      "VINAYA.md",
      ".vinaya/doc-owners"
    ],
    "blocks": [
      {
        "path": ".vinaya/hooks/pre-commit",
        "marker": "pre-commit",
        "comment": "hash"
      },
      {
        "path": ".vinaya/hooks/pre-push",
        "marker": "pre-push",
        "comment": "hash"
      }
    ],
    "labels": [
      "vinaya/tier:0",
      "vinaya/tier:1",
      "vinaya/tier:3",
      "vinaya/needs:execution-input",
      "vinaya/needs:strategy-input",
      "vinaya/needs:principal-input",
      "project:vinaya"
    ]
  }
}
