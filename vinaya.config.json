{
  "rings": {
    "ring1_forgeWriteInterception": true,
    "ring2_asyncAudits": true
  },
  "prePush": {
    "alwaysRun": [
      "apps/cli/tests/ci-shards.test.ts",
      "apps/cli/tests/checks/check-exec-bits.test.ts",
      "apps/cli/tests/checks/changeset-coverage*.test.ts",
      "apps/cli/tests/checks/own-workflow.test.ts",
      "apps/cli/tests/import-boundary.test.ts",
      "apps/cli/tests/surface-spec-exports.test.ts",
      "apps/cli/tests/run-paths-only.test.ts"
    ]
  },
  "checks": {
    "atta-labs/secret-scan": {
      "run": "./scripts/vinaya-checks/secret-scan.ts",
      "scope": "full"
    }
  },
  "ci": {
    "setup": "set -euo pipefail\nGITLEAKS_VERSION=8.30.1\nGITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb\ncurl -fsSL -o /tmp/gitleaks.tar.gz \"https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz\"\necho \"${GITLEAKS_SHA256}  /tmp/gitleaks.tar.gz\" | sha256sum -c -\nsudo tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks\nsudo chmod +x /usr/local/bin/gitleaks\ngitleaks version"
  },
  "releaseActor": "daniboomerang",
  "reviewPolicy": {
    "codeReviewThreshold": "MAJOR",
    "securityThreshold": "HIGH",
    "maxRounds": 7
  },
  "dispatch": {
    "agent": "claude",
    "requireWorkerIsolation": false
  },
  "proseGates": {
    "sourceComments": {
      "globs": ["apps/cli/src", "packages/aeg-core/src", "packages/aeg-forge-state/src", "packages/sources/src"],
      "allowlist": [
        "packages/aeg-forge-state/src/parse-rationale-deps.test.ts",
        "packages/aeg-forge-state/src/amend-rationale-deps.test.ts"
      ],
      "severity": "error"
    },
    "specGrandfather": [
      "apps/cli/specs/isolation.md",
      "apps/cli/specs/log.md",
      "apps/cli/specs/loop.md",
      "apps/cli/specs/self-hosting.md",
      "apps/cli/specs/surface.md"
    ]
  },
  "briefSchema": {
    "pr": {
      "sections": [
        {
          "builtin": "tier"
        },
        {
          "builtin": "testPlan"
        },
        {
          "builtin": "testPlanExclusivity"
        },
        {
          "builtin": "closesN"
        },
        {
          "builtin": "project"
        }
      ]
    },
    "issue": {
      "sections": [
        {
          "builtin": "issueRationale"
        },
        {
          "builtin": "objectives"
        },
        {
          "builtin": "briefSections"
        },
        {
          "builtin": "project"
        }
      ]
    }
  },
  "managed": {
    "version": 3,
    "files": [
      ".github/workflows/vinaya-checks.yml",
      ".github/workflows/vinaya-review.yml",
      ".github/workflows/vinaya-review-retrigger.yml",
      ".github/workflows/vinaya-review-verdict.yml",
      ".github/workflows/vinaya-archivist.yml",
      ".github/workflows/vinaya-body-checks.yml",
      ".github/workflows/vinaya-task-log-collector.yml",
      "vinaya.config.json",
      "VINAYA.md",
      ".vinaya/doc-owners",
      ".claude/settings.json",
      "vinaya/checks/.gitkeep",
      "vinaya/roles/.gitkeep"
    ],
    "blocks": [
      {
        "path": ".vinaya/hooks/pre-commit",
        "marker": "pre-commit",
        "comment": "hash"
      },
      {
        "path": ".vinaya/hooks/pre-push",
        "marker": "pre-push",
        "comment": "hash"
      },
      {
        "path": ".claude/hooks/track-transcript.sh",
        "marker": "track-transcript",
        "comment": "hash"
      }
    ],
    "labels": [
      "vinaya/tier:0",
      "vinaya/tier:1",
      "vinaya/tier:3",
      "vinaya/needs:execution-input",
      "vinaya/needs:strategy-input",
      "vinaya/needs:principal-input",
      "project:vinaya"
    ]
  }
}
