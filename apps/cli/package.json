{
  "name": "@attalabs/vinaya",
  "version": "0.40.0",
  "description": "Vinaya — Agentic Engineering Harness. Deterministic checks every AI coding agent must satisfy before merge.",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "author": "Daniel Estevez",
  "bin": {
    "vinaya": "./dist/index.js",
    "vinaya-select-tests": "./dist/lib/pre-push-select-tests.js",
    "vinaya-changed-files": "./dist/lib/pre-push-changed-files.js",
    "vinaya-cache-test-run": "./dist/lib/pre-push-cache-test-run.js"
  },
  "files": [
    "dist",
    "templates",
    "aeg-root",
    "studio-standalone",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniboomerang/attalabs.git",
    "directory": "apps/cli"
  },
  "homepage": "https://vinaya.attalabs.dev",
  "keywords": [
    "cli",
    "ai-agents",
    "agentic-engineering",
    "governance",
    "checks",
    "git-hooks",
    "code-review"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "bundle-doctrine": "bun scripts/bundle-doctrine.ts",
    "bundle-studio": "bun scripts/bundle-studio.ts",
    "prepack": "bun scripts/build.ts && bun scripts/bundle-doctrine.ts && bun scripts/bundle-studio.ts",
    "test": "bun test --timeout=30000",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "verify-published-lifecycle": "bun scripts/verify-published-lifecycle.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "safe-regex2": "5.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@atta/adapter-langgraph": "file:tests/fixtures/atta-engine/atta-adapter-langgraph-0.0.1.tgz",
    "@atta/agents": "file:tests/fixtures/atta-engine/atta-agents-0.1.0.tgz",
    "@atta/engine": "file:tests/fixtures/atta-engine/atta-engine-0.0.1.tgz",
    "@atta/models": "file:tests/fixtures/atta-engine/atta-models-0.1.0.tgz",
    "@attalabs/aeg-core": "workspace:*",
    "@attalabs/aeg-forge-state": "workspace:*",
    "@atta/typescript-config": "workspace:*",
    "@attalabs/vinaya-sources": "workspace:*",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "@atta/agents": "file:tests/fixtures/atta-engine/atta-agents-0.1.0.tgz",
    "@atta/engine": "file:tests/fixtures/atta-engine/atta-engine-0.0.1.tgz",
    "@atta/models": "file:tests/fixtures/atta-engine/atta-models-0.1.0.tgz"
  }
}
