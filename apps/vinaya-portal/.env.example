# Every environment variable the portal reads. Values are never committed.

# Sanity dataset the content reads from; the first one set wins, "production" when neither is.
SANITY_DATASET=
NEXT_PUBLIC_SANITY_DATASET=

# Optional look override: the id of any uiTheme in the Atta Labs Sanity project, and "light" or "dark".
# Unset, the content management system's own theme config applies.
PORTAL_THEME_ID=
PORTAL_COLOR_SCHEME=

# Optional GitHub token that raises the rate limit of the release-metrics reads; GITHUB_TOKEN wins over GH_TOKEN.
GITHUB_TOKEN=
GH_TOKEN=
