{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Process identity",
  "description": "The identity file every process folder carries as process.yaml. Declared paths are relative to the process folder and must stay inside it.",
  "type": "object",
  "required": ["id", "version", "flow", "roles"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "Stable process identifier." },
    "name": { "type": "string", "minLength": 1, "description": "Display name." },
    "version": { "type": "string", "minLength": 1, "description": "Process version." },
    "flow": { "type": "string", "minLength": 1, "description": "Path of the Flow file." },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Paths of the executing role folders."
    }
  }
}
