      "categories": ["happy-path"],
      "guarantees": ["INV-019", "INV-021", "INV-111", "INV-116"],
      "expect": {
        "decision": "publish",
        "events": {
          "sequence": [
            "loop_started",
            "round_started",
            "gate_result_read",
            "verdicts_read",
            "findings_compared",
            "stop_condition_met",
            "round_ended",
            "journal_finalized",
            "driver_exited"
