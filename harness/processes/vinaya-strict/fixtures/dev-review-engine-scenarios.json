  "scenarios": [
    {
      "id": "clean-completion",
      "title": "A green gate and two clean reviews publish in round 1.",
      "categories": ["happy-path"],
      "guarantees": ["INV-001", "INV-099", "INV-100", "INV-045", "INV-021"],
      "expect": {
        "decision": "publish",
        "durable": {
          "pauseReason": null,
          "controlPhase": "publish",
          "driverLockHeld": false,
          "escalations": 0
        },
        "effects": {
          "publishedRounds": [1],
          "markersInclude": ["reviewer-verdict", "security-verdict", "summary"],
          "developerDispatches": 1,
          "codeReviewerDispatches": 1,
          "securityDispatches": 1
        },
        "events": {
          "journalResults": ["merged_ready"]
        }
      }
    },
    {
      "id": "lifecycle-telemetry",
      "title": "A clean round emits the documented lifecycle events in order, journal_finalized after publication.",
      "categories": ["happy-path"],
      "guarantees": ["INV-019", "INV-021", "INV-111", "INV-116"],
      "expect": {
        "decision": "publish",
        "events": {
          "sequence": [
            "loop_started",
            "round_started",
            "gate_result_read",
            "verdicts_read",
            "findings_compared",
            "stop_condition_met",
            "round_ended",
            "journal_finalized",
            "driver_exited"
          ],
          "uniqueRoundStarts": true
        }
      }
    },
    {
      "id": "requested-changes",
      "title": "A blocking finding returns the round to the developer; a clean round 2 publishes.",
      "categories": ["revisions"],
      "guarantees": ["INV-008", "INV-027", "INV-029", "INV-099"],
      "expect": {
        "decision": "publish",
        "durable": {
          "controlPhase": "publish"
        },
        "effects": {
          "publishedRounds": [2],
          "markersInclude": ["<!-- vinaya:developer:round-2 -->"],
          "developerDispatches": 2,
          "codeReviewerDispatches": 2
        },
        "events": {
          "uniqueRoundStarts": true,
          "journalResults": ["merged_ready"]
        }
      }
    },
    {
      "id": "mechanical-failure-repeats",
      "title": "The same red gate on an unchanged head twice pauses repeat_failure and never reaches a reviewer.",
      "categories": ["developer-failure"],
      "guarantees": ["INV-010", "INV-071", "INV-076", "INV-086"],
      "expect": {
        "decision": "pause:repeat_failure",
        "durable": {
          "pauseReason": "repeat_failure",
          "controlPhase": "pause",
          "escalations": 1
        },
        "effects": {
          "commits": 0,
          "pushes": 0,
          "prOpens": 0,
          "codeReviewerDispatches": 0,
          "securityDispatches": 0,
          "publishedRounds": [],
          "markersInclude": ["<!-- vinaya:loop:paused:repeat_failure -->"]
        },
        "events": {
          "include": ["stop_condition_met", "paused", "handoff:raised"],
          "journalResults": ["stopped"]
        }
      }
    },
    {
      "id": "mechanical-failure-recovers",
      "title": "A red gate the developer fixes reaches review and publishes; each round number starts once.",
      "categories": ["developer-failure", "revisions"],
      "guarantees": ["INV-010", "INV-071", "INV-099"],
      "expect": {
        "decision": "publish",
        "effects": {
          "publishedRounds": [1],
          "developerDispatches": 2
        },
        "events": {
          "uniqueRoundStarts": true,
          "journalResults": ["merged_ready"]
        }
      },
      "expectedDefect": "DEF-03"
    },
    {
      "id": "reviewer-invalidity",
      "title": "A reviewer that under-reports the objectives gets one fresh retry; a second miss pauses infrastructure with no verdict held.",
      "categories": ["invalid-reviews", "reviewer-failure"],
      "guarantees": ["INV-057", "INV-056"],
      "expect": {
        "decision": "pause:infrastructure",
        "durable": {
          "pauseReason": "infrastructure",
          "pauseRound": 1,
          "escalations": 1
        },
        "effects": {
          "codeReviewerDispatches": 2,
          "publishedRounds": [],
          "markersExclude": ["reviewer-verdict", "security-verdict"]
        },
        "events": {
          "include": ["paused"],
          "exclude": ["verdicts_read", "role_attempt:attempted"],
          "journalResults": ["stopped"]
        }
      }
    },
    {
      "id": "reviewer-failure",
      "title": "A reviewer that writes nothing twice pauses infrastructure; the round number is unchanged.",
      "categories": ["reviewer-failure"],
      "guarantees": ["INV-057", "INV-056", "INV-023"],
      "expect": {
        "decision": "pause:infrastructure",
        "durable": {
          "pauseReason": "infrastructure",
          "pauseRound": 1,
          "infrastructureRetries": 1,
          "driverLockHeld": true
        },
        "effects": {
          "securityDispatches": 2,
          "publishedRounds": []
        },
        "events": {
          "exclude": ["verdicts_read"],
          "journalResults": ["stopped"]
        }
      }
    },
    {
      "id": "review-policy-unreadable",
      "title": "An unreadable review policy pauses instead of falling back to defaults, before any dispatch.",
      "categories": ["reviewer-failure"],
      "guarantees": ["INV-103", "INV-109"],
      "expect": {
        "decision": "pause:infrastructure",
        "durable": {
          "pauseReason": "infrastructure",
          "escalations": 1
        },
        "effects": {
          "commits": 0,
          "pushes": 0,
          "prOpens": 0,
          "developerDispatches": 0,
          "codeReviewerDispatches": 0,
          "securityDispatches": 0,
          "publishedRounds": []
        },
        "events": {
          "include": ["paused", "driver_exited"]
        }
      }
    },
    {
      "id": "developer-failure",
      "title": "A developer turn result citing unknown finding ids is rejected twice and pauses.",
      "categories": ["developer-failure", "invalid-reviews"],
      "guarantees": ["INV-013", "INV-031"],
      "expect": {
        "decision": "pause:infrastructure",
        "durable": {
          "pauseReason": "infrastructure",
          "pauseRound": 2,
          "escalations": 1
        },
        "effects": {
          "developerDispatches": 3,
          "codeReviewerDispatches": 1,
          "publishedRounds": []
        },
        "events": {
          "include": ["paused"],
          "journalResults": ["stopped"]
        }
      }
    },
    {
      "id": "provider-failure",
      "title": "A provider CLI that exits non-zero with no session pauses infrastructure and spends one retry.",
      "categories": ["developer-failure"],
      "guarantees": ["INV-023", "INV-109"],
      "expect": {
        "decision": "pause:infrastructure",
        "durable": {
          "pauseReason": "infrastructure",
          "infrastructureRetries": 1,
          "driverLockHeld": true
        },
        "effects": {
          "commits": 0,
          "pushes": 0,
          "prOpens": 0,
          "codeReviewerDispatches": 0,
          "publishedRounds": []
        },
        "events": {
          "include": ["paused"]
        }
      }
    },
    {
      "id": "required-source-failure",
      "title": "A required Documentation source claimed without a counted read rejects the turn; the run never reaches review.",
      "categories": ["developer-failure"],
      "guarantees": ["INV-125", "INV-013"],
      "expect": {
        "decision": "pause:infrastructure",
        "durable": {
          "pauseReason": "infrastructure",
          "escalations": 1
        },
        "effects": {
          "commits": 0,
