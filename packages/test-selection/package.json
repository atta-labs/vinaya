{
  "name": "@attalabs/test-selection",
  "version": "0.2.0",
  "description": "Which tests a change between two committed revisions requires: the TypeScript module graph, a validated test inventory and recorded test reads.",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "author": "Daniel Estevez",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "test-selection": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniboomerang/attalabs.git",
    "directory": "packages/test-selection"
  },
  "keywords": [
    "test-selection",
    "affected-tests",
    "typescript",
    "monorepo",
    "ci"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout=600000"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.7.0"
  }
}
