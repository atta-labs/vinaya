{
  "name": "@attalabs/vinaya-log-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "The Vinaya Log's contract: the event schema, custom-event declarations, redaction and the stored-line classifier.",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "author": "Daniel Estevez",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout=600000"
  },
  "dependencies": {
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/api-logs": "0.223.2",
    "@opentelemetry/otlp-transformer": "0.223.2",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-logs": "0.223.2",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.0.0",
    "typescript": "^5.7.0"
  }
}
