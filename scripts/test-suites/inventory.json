      "kind": "workspace",
      "dir": "harness/kernel",
      "runner": "bun",
      "preload": "apps/cli/tests/lib/test-env-preload.ts",
      "fixtureExecutables": ["harness/kernel/log/fixtures/executions.test.ts"]
    },
    {
      "id": "process-vinaya",
      "owner": "@attalabs/process-vinaya",
      "kind": "workspace",
      "dir": "harness/processes/vinaya-strict",
      "runner": "bun",
      "preload": "apps/cli/tests/lib/test-env-preload.ts"
    },
    {
      "id": "repository",
      "owner": "repository",
      "kind": "repository",
      "dir": ".",
      "runner": "bun",
      "preload": "apps/cli/tests/lib/test-env-preload.ts",
      "tests": [
        "scripts/vinaya-checks/ui-rules.test.ts",
        "scripts/vinaya-checks/process-version-bump.test.ts",
        "scripts/test-suites/inventory-check.test.ts",
        "scripts/test-suites/bun-runtime.test.ts",
        "scripts/test-suites/relocation-fixture.test.ts",
        "scripts/test-suites/schedule.test.ts",
        "scripts/test-suites/staged-driver-move.test.ts"
      ]
    },
    {
      "id": "package-compat",
      "owner": "repository",
      "kind": "compatibility",
      "dir": ".",
      "runner": "bun",
      "preload": "apps/cli/tests/lib/test-env-preload.ts",
      "tests": ["scripts/package-compat/package-compat.test.ts"]
    }
  ],
  "typeInputs": [
    {
      "path": "packages/typescript-config",
      "role": "shared TypeScript configuration package with no tests"
    },
    {
      "path": "packages/typescript-config/base.json",
      "role": "the TypeScript base configuration every package extends"
    },
    {
      "path": "tsconfig.json",
      "role": "the repository-root TypeScript configuration"
    }
  ],
  "exclusions": [],
  "inputs": [
    {
      "id": "root-config",
      "kind": "config",
      "paths": ["vinaya.config.json"],
      "format": "json",
      "readers": [
        {
          "kind": "semantic",
          "suites": ["cli"]
        }
      ],
      "reason": "Every CLI command a CLI test starts reads the parsed repository configuration; the selector forces the CLI suite on its change for the same reason."
    },
    {
      "id": "lockfile",
      "kind": "lockfile",
      "paths": ["bun.lock"],
      "format": "bun-lock",
      "readers": [
        {
          "kind": "semantic",
          "suites": [
            "cli",
            "log-server",
            "portal",
            "aeg-core",
            "sources",
            "kernel",
            "process-vinaya",
            "repository",
            "package-compat"
          ]
        }
      ],
      "reason": "The lockfile decides every installed dependency every suite runs against; it is read as its dependency identity, so a workspace folder or local path move alone changes no installed dependency."
    },
    {
      "id": "config-probe-program",
      "kind": "spawn",
      "paths": ["scripts/ci/config-probe.ts"],
      "readers": [
        {
          "kind": "code",
