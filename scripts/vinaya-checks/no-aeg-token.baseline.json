{
  "allowlist": [
    {
      "glob": "**/evals/**/*-cases.json",
      "reason": "Evaluation case files: recorded task statements and expected verdicts an evaluation replays verbatim; editing them changes what the evaluation measures."
    },
    {
      "glob": "**/evals/**/*-held-out.json",
      "reason": "Held-out evaluation case files: recorded task statements kept apart from tuning and replayed verbatim; editing them changes what the evaluation measures."
    },
    {
      "glob": "harness/kernel/evals/suites/**/*.json",
      "reason": "Generic evaluation case files: recorded task statements the generic suites replay verbatim."
    },
    {
      "glob": "harness/processes/vinaya-strict/evals/suites/**/*.json",
      "reason": "Recorded evaluation suite files: captured runs, facts and registries the process evaluations read as recorded."
    },
    {
      "glob": "harness/processes/vinaya-strict/evals/suites/failure-taxonomy/bundle.jsonl",
      "reason": "The failure-taxonomy bundle: real failures captured from past runs, quoted as they happened."
    },
    {
      "glob": "**/fixtures/**/*.jsonl",
      "reason": "Recorded agent-stream fixtures: agent output captured byte for byte, which parsers are tested against as it was emitted."
    },
    {
      "glob": "**/fixtures/**/pr-body-*.md",
      "reason": "Recorded pull-request-body fixtures: bodies captured from the forge as opened, which the body parsers must keep reading."
    },
    {
      "glob": "**/fixtures/forge/pr-*.md",
      "reason": "Recorded pull-request-body fixtures: bodies captured from the forge, which the body parsers must keep reading."
    },
    {
      "glob": "harness/kernel/adapters/code-host/github/fixtures/forge-snapshot/**",
      "reason": "Recorded pull-request-body fixtures: forge responses captured as returned, bodies included."
    },
    {
      "glob": "docs/adr/**",
      "reason": "Decision records: immutable once accepted; they quote the names in use when each decision was taken."
    },
    {
      "glob": "**/CHANGELOG.md",
      "reason": "Changelogs: released entries are never rewritten."
    },
    {
      "glob": "bun.lock",
      "reason": "The lockfile: its hits are base64 sha512 integrity strings, which the package manager writes and nobody edits."
    },
    {
      "glob": "harness/processes/vinaya-strict/checks/docs/fixtures/docs-coherence/broken/tranches/aeg-fake.md",
      "reason": "A fixture file named after a tranche slug: its path is the input the coherence check is tested on."
    },
    {
      "glob": "harness/processes/vinaya-strict/tools/pr-report/tokens/fixtures/aeg-ui-v1-tokens.md",
      "reason": "A fixture file named after a tranche slug: its path is the input the token report is tested on."
    },
    {
      "glob": "harness/processes/vinaya-strict/tools/task-contract/fixtures/aeg-ui-v1.md",
      "reason": "A fixture file named after a tranche slug: its path is the input the task-contract parser is tested on."
    },
    {
      "glob": "scripts/vinaya-checks/no-aeg-token*",
      "reason": "The guard's own files: the check, its tests and this data file must spell the token they count."
    },
    {
      "glob": "harness/processes/vinaya-strict/tools/legacy-markers.ts",
      "reason": "The one legacy-spelling module: it reads markers written under the old prefix, so it must spell that prefix."
    },
    {
      "glob": "harness/processes/vinaya-strict/tools/prose-rules.ts",
      "reason": "The retired-name prose rule: it must spell the word it bans."
    },
    {
      "glob": "harness/processes/vinaya-strict/tools/task-contract/**/fixtures/issue-*-body.md",
      "reason": "Recorded Issue-body fixtures: task Issue bodies captured from the forge as cut, which the Issue and brief parsers must keep reading."
    },
    {
      "glob": "harness/processes/vinaya-strict/integration/config/fixtures/config-golden/**",
      "reason": "Configuration golden files: the configuration surface recorded as it was emitted, which the configuration tests compare against as recorded."
    },
    {
      "glob": "harness/processes/vinaya-strict/fixtures/dev-review-architecture-invariants.json",
      "reason": "A recorded architecture-invariants fixture: the review loop's module layout captured as it stood, which the architecture test compares against."
    },
    {
      "glob": "harness/processes/vinaya-strict/tools/task-contract/fixtures/projects.md",
      "reason": "A recorded projects-registry fixture: a projects file captured with historical tranche slugs, which the registry parser is tested on."
    },
    {
      "glob": "harness/processes/vinaya-strict/tools/fixtures/doc-owners-with-bindings",
      "reason": "A recorded documentation-owners fixture: an owners file captured with historical bindings, which the owners reader is tested on."
    }
