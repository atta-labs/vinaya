# Dependencies
node_modules/

# Build
dist/
build/
out/
**/.turbo/

# bundle-doctrine.ts copies the repo-root aeg-root/ (source of truth, tracked)
# into apps/cli/aeg-root/ at pack time so the doctrine ships in the tarball.
# That copy is a build artifact, not a second source of truth.
/apps/cli/aeg-root/

# bundle-studio.ts copies the standalone Studio build into
# apps/cli/studio-standalone/ — only possible when a Studio source tree is
# available (see that script's guard; not the case in this repository today).
# Build artifact, never tracked.
/apps/cli/studio-standalone/

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# TypeScript
*.tsbuildinfo

# Worktrees
.worktrees/
.claude/worktrees/
