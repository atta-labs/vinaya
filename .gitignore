# Dependencies
node_modules/

# Build
dist/
build/
out/
**/.turbo/

# bundle-doctrine.ts copies the repo-root aeg-root/ (source of truth, tracked)
# into apps/cli/aeg-root/ at pack time so the doctrine ships in the tarball.
# That copy is a build artifact, not a second source of truth.
/apps/cli/aeg-root/

# bundle-studio.ts fetches attalabs' published Studio release artifact and
# assembles it into apps/cli/studio-standalone/ at prepack time. Build
# artifact, never tracked.
/apps/cli/studio-standalone/

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# TypeScript
*.tsbuildinfo

# Worktrees
.worktrees/
.claude/worktrees/

# Developer's side channel to the review-loop driver: written at the root of
# a task worktree, read once and deleted by the driver. Never tracked.
.vinaya-confidence
.vinaya-round-response
